NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Vídeo institucional provisório (Aliviar 1.0).
# Copiar o arquivo para public/film/aliviar.mp4 antes do deploy,
# ou apontar NEXT_PUBLIC_ALIVIAR_FILM_SRC para a URL oficial.
# Sem o asset, a landing usa fallback editorial (poster) — sem request 404.
NEXT_PUBLIC_ALIVIAR_FILM_SRC=/film/aliviar.mp4
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
