NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca prefixar com NEXT_PUBLIC_ — nunca deve chegar ao bundle do cliente.
# Usada apenas em src/lib/supabase/admin.ts (server-only), para operações
# administrativas de conta (criação de paciente pela equipe Aliviar,
# redefinição de senha, bloqueio/desbloqueio de acesso).
SUPABASE_SERVICE_ROLE_KEY=

# GO LIVE — fornecedor real do AceLanguageModel (P002/P003/P004/P010).
# Nunca prefixar com NEXT_PUBLIC_ — usada apenas em
# src/modules/concierge/anthropic-language-model.ts (server-only). Ausente
# em desenvolvimento/teste: o sistema usa automaticamente o
# FakeAceLanguageModel determinístico (ver src/modules/concierge/
# language-model.ts, getAceLanguageModel). Ausente em produção
# (NODE_ENV=production): a execução do ACE falha explicitamente
# (AceLanguageModelConfigurationError, failureCode
# ACE_MODEL_NOT_CONFIGURED) — nunca cai silenciosamente no modelo fake.
ANTHROPIC_API_KEY=
# Opcional — sobrescreve o modelo padrão (claude-sonnet-5) sem precisar
# alterar código.
ANTHROPIC_MODEL=
