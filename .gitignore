# Variáveis de ambiente e credenciais — nunca commitar
.env
.env.*
!.env.example
!.env.test.example
*.local.json
*.local.sql
**/.env.admin.local
**/.env.admin.*.local
**/.tmp-*.sql

# Dependências
node_modules/
/.pnp
.pnp.*

# Build e artefatos comuns
/build
/dist
/out
/.next/
.vercel
.supabase
supabase/.temp/
supabase/.branches/
*.tsbuildinfo

# Testes / cobertura
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Golden Set — diagnóstico local de falhas (sanitizado, mas nunca commitado)
/.golden-results/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Caches
.cache/
.turbo/
.eslintcache

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code — mantém apenas configuração de projeto compartilhável
# (launch.json, sem segredo/caminho de máquina); settings.local.json e
# arquivos de lock de sessão são locais por definição (já cobertos também
# por *.local.json acima).
.claude/*
!.claude/launch.json
!.claude/agents/
!.claude/agents/*.md

# Identidade de build local — gerada por scripts/new-build-id.mjs a cada
# construção; versioná-la congelaria o id de uma máquina (Auditoria F9/GOV-04)
.build-id

# Travas de exclusão mútua entre suítes (tests/execucao-exclusiva.ts:23) —
# locais por definição, uma por máquina
.*-run.lock

# Arquivos temporários
*.tmp
*.temp
*~

# Homologação local (nunca commitar segredos ou relatórios de execução)
scripts/local/.validation-env.json
scripts/local/validation-report.json
scripts/local/.env.admin.local
scripts/local/.tmp-password-update.sql

# Espelho do stdout do servidor E2E — analisado pelo gate de erros estruturados
.e2e-server.log

# Backups locais de verificação de restore (Bloco I) — nunca versionados
.backups/

# Capturas de verificacao em navegador (Etapa 2D em diante): evidencia de
# execucao local, regenerada pelo proprio spec. Nao versionada — binario que
# muda a cada rodada e nao se le em diff.
evidencias/

# Guias operacionais: o FONTE é o HTML em docs/guias/, versionado e revisável.
# O PDF é produto — regenerável por `node scripts/gerar-guias-pdf.mjs`, e por
# isso fora do Git: binário que muda a cada regeração polui o histórico.
docs/guias/pdf/
