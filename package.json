{
  "name": "aliviar-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "alicia:coverage": "node scripts/generate-es-coverage-report.mjs",
    "alicia:seed": "node scripts/build-es-catalog-seed.mjs",
    "admin:bootstrap": "node scripts/local/bootstrap-admin-profile.mjs",
    "alpha:validate": "node scripts/local/validate-alpha-0.1.mjs",
    "validation:diagnose": "node scripts/local/diagnose-validation-env.mjs",
    "validation:prepare": "node scripts/local/prepare-validation-env.mjs",
    "validation:e2e": "node scripts/local/validate-e2e-real.mjs",
    "go-live:readiness": "node scripts/local/validate-go-live-readiness.mjs",
    "e2e:smoke": "vitest run src/validation/smoke-e2e.test.ts",
    "e2e:smoke:http": "node scripts/local/validate-e2e-smoke.mjs",
    "e2e": "npm run e2e:smoke",
    "landing:rc": "vitest run src/components/experience/limiar/ && npm run typecheck",
    "journey-handoff:rc": "vitest run src/journey-handoff/ && npm run typecheck",
    "vertical-slice:rc": "vitest run src/vertical-slice/ && npm run typecheck",
    "admin:check": "node scripts/local/check-admin-env.mjs",
    "admin:set-password": "node scripts/local/set-admin-password.mjs",
    "admin:setup": "node scripts/local/setup-admin.mjs",
    "admin:setup:gui": "powershell -ExecutionPolicy Bypass -File scripts/local/setup-admin-interactive.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release/release.ps1",
    "release:verify": "powershell -ExecutionPolicy Bypass -File scripts/release/verify-production.ps1",
    "release:rollback": "powershell -ExecutionPolicy Bypass -File scripts/release/rollback.ps1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "leaflet": "^1.9.4",
    "next": "16.2.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.10",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.29",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.28.0",
    "eslint-config-next": "16.2.10",
    "happy-dom": "^20.11.1",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
