    "test:components": "vitest run --config vitest.components.config.ts",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "test:e2e": "node scripts/with-local-supabase.mjs playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "node scripts/guard-db-reset.mjs",
    "supabase:env": "node scripts/generate-local-env.mjs",
    "bootstrap:test-users": "node scripts/with-local-supabase.mjs node scripts/bootstrap-local-test-users.mjs",
    "admin:set-password": "node scripts/local/set-admin-password.mjs",
    "validation:diagnose": "node scripts/local/diagnose-validation-env.mjs",
    "validation:prepare": "node scripts/local/prepare-validation-env.mjs",
    "validation:e2e": "node scripts/local/validate-e2e-real.mjs",
    "validation:e2e:b6": "node scripts/local/validate-e2e-curadoria-b6.mjs",
    "dev:local": "node scripts/with-local-supabase.mjs next dev",
    "test:integration:local": "node scripts/with-local-supabase.mjs vitest run --config vitest.integration.config.ts",
    "test:e2e:local": "node scripts/with-local-supabase.mjs playwright test",
    "bootstrap:test-users:local": "node scripts/with-local-supabase.mjs node scripts/bootstrap-local-test-users.mjs",
    "seed:rede-demo:local": "node scripts/with-local-supabase.mjs node scripts/seed-rede-demonstracao.mjs",
    "seed:mesa:local": "node scripts/with-local-supabase.mjs --env SEED_MESA=1 vitest run --config vitest.integration.config.ts tests/integration/seed-validacao-mesa.integration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.8",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "gsap": "^3.15.0",
    "lucide-react": "^1.24.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "eslint-config-prettier": "^10.1.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
